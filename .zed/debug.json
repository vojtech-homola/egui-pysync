// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Showcase GUI",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build", "-p", "showcase_gui", "--bin", "showcase-gui"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/showcase-gui",
    "request": "launch",
    "env": {
      "WAYLAND_DISPLAY": ""
    },
    "sourceLanguages": ["rust"]
  },
  {
    "label": "Showcase Python server",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/example/showcase/python/run.py"
  }
]
